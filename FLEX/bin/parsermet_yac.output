Gramática

    0 $accept: prog $end

    1 prog: NT_DEC NUMERO FX_DEC expr FDX_DEC expr ERROR_DEC NUMERO '}'
    2     | PF_DEC NUMERO FX_DEC expr GX_DEC expr ERROR_DEC NUMERO '}'
    3     | X_DEC NUMERO FX_DEC expr '}'
    4     | NT_DEC ERROR_T
    5     | NT_DEC NUMERO ERROR_T
    6     | NT_DEC NUMERO FX_DEC expr ERROR_T
    7     | NT_DEC NUMERO FX_DEC expr FDX_DEC expr ERROR_DEC ERROR_T
    8     | NT_DEC NUMERO FX_DEC expr FDX_DEC expr ERROR_DEC NUMERO ERROR_T
    9     | ERROR_T

   10 expr: expr '+' term
   11     | expr '-' term
   12     | term

   13 term: term '*' factor
   14     | term '/' factor
   15     | term '^' factor
   16     | factor

   17 factor: NUMERO
   18       | sig X
   19       | sig EULER
   20       | sig PI
   21       | sig '(' expr ')'
   22       | sig SIN '(' expr ')'
   23       | sig COS '(' expr ')'
   24       | sig TAN '(' expr ')'
   25       | sig COSEC '(' expr ')'
   26       | sig SEC '(' expr ')'
   27       | sig COT '(' expr ')'
   28       | sig ASIN '(' expr ')'
   29       | sig ACOS '(' expr ')'
   30       | sig ATAN '(' expr ')'
   31       | sig SINH '(' expr ')'
   32       | sig COSH '(' expr ')'
   33       | sig TANH '(' expr ')'
   34       | sig LOGE '(' expr ')'
   35       | sig LOG10 '(' expr ')'
   36       | sig EXP '(' expr ')'
   37       | sig RAIZ '(' expr ')'

   38 sig: '+'
   39    | '-'
   40    | /* vacío */


