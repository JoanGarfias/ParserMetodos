Gramática

    0 $accept: prog $end

    1 prog: NT_DEC NUMERO FX_DEC expr FDX_DEC expr ERROR_DEC NUMERO '}'
    2     | PF_DEC NUMERO FX_DEC expr GX_DEC expr ERROR_DEC NUMERO '}'
    3     | X_DEC NUMERO FX_DEC expr '}'

    4 expr: expr '+' term
    5     | expr '-' term
    6     | term

    7 term: term '*' factor
    8     | term '/' factor
    9     | term '^' factor
   10     | factor

   11 factor: sig NUMERO
   12       | sig X
   13       | sig EULER
   14       | sig PI
   15       | sig '(' expr ')'
   16       | sig SIN '(' expr ')'
   17       | sig COS '(' expr ')'
   18       | sig TAN '(' expr ')'
   19       | sig COSEC '(' expr ')'
   20       | sig SEC '(' expr ')'
   21       | sig COT '(' expr ')'
   22       | sig ASIN '(' expr ')'
   23       | sig ACOS '(' expr ')'
   24       | sig ATAN '(' expr ')'
   25       | sig SINH '(' expr ')'
   26       | sig COSH '(' expr ')'
   27       | sig TANH '(' expr ')'
   28       | sig LOGE '(' expr ')'
   29       | sig LOG10 '(' expr ')'
   30       | sig EXP '(' expr ')'
   31       | sig RAIZ '(' expr ')'

   32 sig: '+'
   33    | '-'
   34    | /* vacío */


